model JourneyTask {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  journeyDayId     String      @db.ObjectId
  title            String
  type             String
  estimatedMinutes Int
  xp               Int
  completed        Boolean     @default(false)
  metadata         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyDayId])
}

model UserJourneyProgress {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  userId             String        @db.ObjectId
  journeyId          String?       @db.ObjectId
  currentDay         Int           @default(1)
  completionPercentage Float        @default(0)
  streak             Int           @default(0)
  xp                 Int           @default(0)
  adaptiveMode       String        @default("growth")
  weakSkills         String[]
  completedSkills    String[]
  nextAction         String?
  lastActiveAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([journeyId])
}

model SkillProgress {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String        @db.ObjectId
  journeyId      String?       @db.ObjectId
  skill          String
  mastery        Float
  completed      Boolean       @default(false)
  weak           Boolean       @default(false)
  progressHistory Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([journeyId])
  @@index([skill])
}

model JobEligibility {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  journeySlug      String
  jobId            String
  title            String
  company          String
  role             String
  location         String
  salary           String?
  requiredSkills   String[]
  missingSkills    String[]
  matchPercentage  Int
  eligible         Boolean  @default(false)
  source           String
  applied          Boolean  @default(false)
  appliedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([journeySlug])
  @@index([jobId])
}

model PlacementReadiness {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @db.ObjectId
  journeyId        String?       @db.ObjectId
  score            Int
  label            String
  completedSkills  String[]
  missingSkills    String[]
  eligibleJobs     Int
  nextAction       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([journeyId])

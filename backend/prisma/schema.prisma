generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  VIDEO
  ARTICLE
  DOCUMENTATION
  BOOK
  COURSE
  PRACTICE
  PROJECT
  CHEATSHEET
  OTHER
}

// ============ RECRUITMENT ENUMS ============

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  FILLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FREELANCE
  CONTRACT
}

enum WorkMode {
  REMOTE
  ON_SITE
  HYBRID
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  SELECTED
  ACCEPTED
  DECLINED
}

// ============ PHASE 2: AUTHENTICATION ENUMS ============

enum UserRole {
  ADMIN
  PLACEMENT_OFFICER
  RECRUITER
  STUDENT
}

enum AccountStatus {
  EMAIL_PENDING
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrganizationType {
  COLLEGE
  UNIVERSITY
  BOOTCAMP
  TRAINING_INSTITUTE
  MSME
  STARTUP
  COMPANY
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_RESET
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGE_FAILED
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  RECRUITER_VERIFIED
  RECRUITER_REJECTED
  USER_SUSPENDED
  USER_ACTIVE
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITATION
  MAGIC_LOGIN
  EMAIL_CHANGE
}

enum NotificationType {
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  JOB_APPLICATION
  INTERVIEW_SCHEDULED
  OFFER_RECEIVED
}

enum NotificationChannel {
  DATABASE
  EMAIL
  PUSH
  SMS
}

// ============ PHASE 2: AUTHENTICATION MODELS ============

model Organization {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String   @unique
  type             OrganizationType
  email            String?
  phone            String?
  website          String?
  address          String?
  city             String?
  state            String?
  country          String?
  logo             String?
  description      String?
  verified         Boolean  @default(false)
  isActive         Boolean  @default(true)

  // Relations
  studentProfiles         StudentProfile[]
  recruiterProfiles       RecruiterProfile[]
  placementOfficerProfiles PlacementOfficerProfile[]
  invitations             Invitation[]
  auditLogs               AuditLog[]
  notifications           Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([verified])
  @@index([isActive])
}

model Role {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             UserRole @unique
  permissions      String[] @default([])
  description      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  action           String   @unique
  resource         String
  description      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resource])
}

model StudentProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  rollNumber       String?
  courseYear       String?
  branch           String?
  cgpa             Float?
  tenthBoard       String?
  tenthScore       Float?
  twelfthBoard     String?
  twelfthScore     Float?
  resumeUrl        String?
  linkedinUrl      String?
  githubUrl        String?
  skills           String[] @default([])
  interests        String[] @default([])
  experiences      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model RecruiterProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  companyName      String
  designation      String
  department       String?
  verified         Boolean  @default(false)
  verifiedAt       DateTime?
  verificationNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([verified])
}

model PlacementOfficerProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  designation      String
  department       String?
  officePhone      String?
  verified         Boolean  @default(false)
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([verified])
}

model Invitation {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  email            String
  role             UserRole
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  invitedByUserId  String   @db.ObjectId
  invitedByUser    User     @relation("invitedBy", fields: [invitedByUserId], references: [id])
  
  acceptedByUserId String?  @db.ObjectId
  acceptedByUser   User?    @relation("invitedUser", fields: [acceptedByUserId], references: [id])
  
  token            String   @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  status           String   @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId, role])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
}

model AuditLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  targetUserId     String   @db.ObjectId
  targetUser       User     @relation("auditLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  
  performedByUserId String  @db.ObjectId
  performedByUser  User     @relation("auditLogPerformedBy", fields: [performedByUserId], references: [id], onDelete: Cascade)
  
  organizationId   String?  @db.ObjectId
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  
  action           AuditAction
  status           String   @default("SUCCESS")
  failureReason    String?                       // Structured failure reason (USER_NOT_FOUND, EMAIL_NOT_VERIFIED, etc.)
  
  resourceType     String?
  resourceId       String?
  changes          Json?
  ipAddress        String?
  userAgent        String?

  createdAt DateTime @default(now())

  @@index([targetUserId])
  @@index([performedByUserId])
  @@index([organizationId])
  @@index([action])
  @@index([status])
  @@index([failureReason])
  @@index([createdAt])
}

model Notification {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  user             User     @relation("notifications", fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  type             NotificationType
  title            String
  message          String
  channels         NotificationChannel[]
  
  read             Boolean  @default(false)
  readAt           DateTime?
  
  sentViaEmail     Boolean  @default(false)
  sentViaPush      Boolean  @default(false)
  sentViaSMS       Boolean  @default(false)
  
  metadata         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
}

// ============ USER MODELS ============

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  email            String   @unique
  fullName         String
  password         String
  provider         String   @default("local")
  providerId       String?
  avatar           String?
  profilePicture   String?
  emailVerified    Boolean  @default(false)
  role             String   @default("USER")
  
  // Phase 2: Authentication fields
  userRole         UserRole?
  accountStatus    AccountStatus @default(EMAIL_PENDING)
  emailVerifiedAt  DateTime?
  status           AccountStatus @default(EMAIL_PENDING)
  lastLoginAt      DateTime?
  lastLoginIp      String?                // Last login IP address
  lastLoginUserAgent String?              // Last login user agent
  organizationId   String?  @db.ObjectId
  isActive         Boolean  @default(true)
  
  // OAuth fields
  oauthProvider    String?  // "google" or "github"
  oauthProviderId  String?
  
  age              Int?
  location         String?
  phone            String?
  linkedin         String?
  skills           String[]
  interests        String[]
  preferences      String[]
  experience       String?
  experienceType   String?  @default("fresher")
  education        String?
  educationEntries Json?
  skillLevel       String?
  tenthBoard       String?
  tenthScore       String?
  twelfthBoard     String?
  twelfthScore     String?
  currentCourse    String?
  cgpa             String?
  xp               Float    @default(0)
  streak           Int      @default(0)
  level            Int      @default(1)
  currentTitle     String?
  careerTrack      String?
  // â”€â”€ Phase 1 profile fields â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  gender                  String?
  firstName               String?
  lastName                String?
  country                 String?
  state                   String?
  city                    String?
  currentStatus           String?
  collegeName             String?
  university              String?
  degree                  String?
  branch                  String?
  currentYear             String?
  expectedGraduationYear  Int?
  programmingExperience   String?
  previouslyWorked        Boolean? @default(false)
  yearsOfExperience       Float?
  currentCompany          String?
  currentRole             String?
  careerGoal              String?
  username                String?
  bio                     String?
  githubUrl               String?
  portfolioWebsite        String?
  dateOfBirth             DateTime?
  preferredCareerDomain   String?
  preferredLearningStyle  String?
  dailyStudyHours         Int?
  targetSalary            String?
  preferredWorkMode       WorkMode?
  preferredCompanyType    String?
  preferredLocation       String?
  languagePreference      String?
  themePreference         String?
  notificationPreferences Json?
  privacySettings         Json?
  accountSettings         Json?
  profileCompletion       Float?

  // ── Account lifecycle ────────────────────────────────────────────────────
  deleteRequestedAt       DateTime? // set when user requests account deletion

  // ── Two-factor authentication ────────────────────────────────────────────
  twoFactorEnabled        Boolean  @default(false)
  twoFactorSecret         String?  // TOTP secret (base32)

  // Relations
  refreshTokens           RefreshToken[]
  socialAccounts          SocialAccount[]
  githubRepositories      GithubRepository[]
  portfolioProjects       UserPortfolioProject[]
  certifications          UserCertification[]
  assessmentAnswers       AssessmentAnswer[]
  userAssessmentAnswers   UserAssessmentAnswer[]
  assessmentResults       AssessmentResult[]
  assessmentSessions      AssessmentSession[]
  progress                UserProgress[]
  completedRoadmaps       CompletedRoadmap[]
  completedTaskHistory    CompletedTaskHistory[]
  achievements            UserAchievement[]
  userXpLogs              UserXpLog[]
  dailyQuizAttempts       DailyQuizAttempt[]
  dailyLearning           UserDailyLearning[]
  userRoadmaps            UserRoadmap[]
  assessmentRoadmap       AssessmentRoadmap?
  taskProgress            TaskProgress[]
  resourceLearningHistory  ResourceLearningHistory[]
  careerMatches           CareerMatch[]
  csvCareerMatches        CSVCareerMatch[]
  careerRecommendationSnapshots CareerRecommendationSnapshot[]
  skillGapAnalyses        SkillGapAnalysis[]
  careerPerformanceScore  CareerPerformanceScore?
  jobApplications         JobApplication[]
  dailyAnalyticsSnapshots  DailyAnalyticsSnapshot[]
  userResourceProgress    UserResourceProgress[]
  // Relations added to satisfy relation fields referenced elsewhere
  savedItems              SavedItem[]
  activityLogs            ActivityLog[]
  feedbacks               Feedback[]
  // AI Memory & Personalization relations
  aiMemoryProfiles        AIMemoryProfile[]
  recommendationHistories RecommendationHistory[]
  recommendationSnapshots RecommendationSnapshot[]
  roadmapMutations        RoadmapMutation[]
  personalityProfiles     PersonalityProfile[]
  learningVelocities      LearningVelocity[]
  decisionSnapshots       DecisionSnapshot[]
  generatedNotes          GeneratedNote[]
  
  // Phase 2: Auth relations
  verificationTokens     VerificationToken[]
  studentProfile         StudentProfile?
  recruiterProfile       RecruiterProfile?
  placementOfficerProfile PlacementOfficerProfile?
  invitationsReceived    Invitation[] @relation("invitedUser")
  invitationsSent        Invitation[] @relation("invitedBy")
  auditLogsTarget        AuditLog[] @relation("auditLogTarget")
  auditLogsPerformedBy   AuditLog[] @relation("auditLogPerformedBy")
  notifications          Notification[] @relation("notifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([provider, providerId])
  @@index([userRole])
  @@index([accountStatus])
  @@index([isActive])
  @@index([organizationId])
  @@index([updatedAt])                     // For fetching recently active users
}

// Intelligence debug audit logs for admin access to sensitive intelligence payloads
model IntelligenceDebugAudit {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId    String   @db.ObjectId
  targetUser String?  @db.ObjectId
  endpoint   String
  filters    Json?
  env        String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetUser])
}

model SocialAccount {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  providerId    String
  email         String?
  username      String?
  avatar        String?
  accessToken   String?
  refreshToken  String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
}

model GithubRepository {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoId        String
  name          String
  fullName      String
  htmlUrl       String
  description   String?
  language      String?
  stars         Int      @default(0)
  forks         Int      @default(0)
  isPrivate     Boolean  @default(false)
  defaultBranch String?
  pushedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, repoId])
  @@index([userId])
}

model UserPortfolioProject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  techStack   String[] @default([])
  highlights  String[] @default([])
  liveUrl     String?
  repoUrl     String?
  featured    Boolean  @default(false)
  source      String   @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserCertification {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  issuer        String
  credentialId  String?
  credentialUrl String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  description   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String?                       // SHA256(rawToken), never store raw token
  familyId  String?                       // Session family ID for token rotation tracking
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  revokedAt DateTime?                     // Non-null = token revoked (security incident)
  
  // Device metadata for multi-device logout and security
  deviceId  String?                       // Device/browser fingerprint
  ipAddress String?                       // IP at login time
  userAgent String?                       // User-Agent at login time
  lastUsedAt DateTime?                    // Last refresh time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for token refresh & session management
  @@index([tokenHash])                    // Index only, not unique (handles NULLs)
  @@index([userId])                       // Fast lookups by user during logout
  @@index([familyId])                     // For revoking entire family
  @@index([expiresAt])                    // For cleanup queries
  @@index([revokedAt])                    // For security queries
}

model VerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String?
  purpose   TokenPurpose @default(EMAIL_VERIFY)
  expiresAt DateTime?
  usedAt    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for verification token lookups
  @@index([tokenHash])                    // Fast token validation
  @@index([userId])                       // Find user's verification tokens
  @@index([purpose])                      // Filter by token purpose
}

model SecurityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  event     String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

model SavedItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType    String
  itemId      String?
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([itemType])
}

model ActivityLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      String
  category   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([category])
}

model Feedback {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @db.ObjectId
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            String
  rating              Int      @default(0)
  title               String
  description         String
  screenshotUrl       String?
  imageUrl            String?
  priority            String   @default("Medium")
  status              String   @default("Open")
  allowContact        Boolean  @default(false)
  anonymous           Boolean  @default(false)
  adminReply               String?
  adminNotes               String?
  adminReplyReadAt         DateTime?    // null = user hasn't read the reply yet
  confirmationEmailSent    Boolean      @default(false)
  confirmationEmailSentAt  DateTime?    // when confirmation was successfully sent
  relatedAssessmentId      String?
  metadata                 Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model AIUsage {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  actorKey      String
  userId        String?  @db.ObjectId
  date          String
  dailyRequests Int      @default(0)
  tokensUsed    Int      @default(0)
  lastRequest   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([actorKey, date])
  @@index([userId])
  @@index([date])
  @@index([lastRequest])
}

model PasswordResetOTP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// ============ SKILL & ROADMAP MODELS ============

model Skill {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  skillName      String   @unique
  skillCategory  String
  difficulty     String
  description    String
  totalDuration  String
  estimatedHours Int
  icon           String
  color          String
  prerequisites  String[]
  relatedSkills  String[]
  totalDays      Int

  // Relations
  weeklyModules WeeklyModule[]
  dailyTasks    DailyTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyTask {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  skillId       String   @db.ObjectId
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  taskNumber    Int
  title         String
  description   String
  estimatedTime String
  subtasks      String[]
  xp            Int      @default(0)

  // Relations
  resources    Resource[]
  taskProgress TaskProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillId])
}

model WeeklyModule {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  skillId      String  @db.ObjectId
  skill        Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  moduleNumber Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillId])
}

model Resource {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  taskId      String    @db.ObjectId
  task        DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  url         String
  description String?
  platform    String
  type        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model LearningResource {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  resourceKey      String   @unique
  roadmapId        String?  @db.ObjectId
  roadmap          Roadmap? @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapCategory  String
  roadmapTitle     String?
  skill            String
  topic            String
  topicSlug        String
  dayNumber        Int?
  resourceType     String
  difficulty       String
  source           String   @default("curated")
  title            String
  url              String
  description      String
  provider         String
  estimatedMinutes Int?
  isOfficial       Boolean  @default(false)
  aiScore          Float    @default(0)
  tags             String[]
  metadata         Json?

  history ResourceLearningHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roadmapId])
  @@index([roadmapCategory])
  @@index([skill])
  @@index([topic])
  @@index([resourceType])
  @@index([difficulty])
}

model ResourceLearningHistory {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  userId          String           @db.ObjectId
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId      String           @db.ObjectId
  resource        LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  roadmapId       String?          @db.ObjectId
  roadmap         Roadmap?         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  completed       Boolean          @default(false)
  progressPercent Int              @default(0)
  quizScore       Float?
  notes           String?
  source          String           @default("manual")
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([roadmapId])

  problemSolvingLevel      String? // low, medium, high
  
  // Aggregate performance score
  overallPerformanceScore  Float   @default(0) // 0-100
  
  // Tracking
  lastAssessmentDate       DateTime?
  assessmentCount          Int     @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([overallPerformanceScore])
  @@index([technicalLevel])
  @@index([lastAssessmentDate])
}

// ============ JOB MODELS ============

model Job {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  company     String
  location    String
  description String
  salary      Json?
  skills      String[]
  applyLink   String
  source      String
  createdAt   DateTime @default(now())

  applications JobApplication[]
}

model JobApplication {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String   @db.ObjectId
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String   @default("APPLIED")
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

// ============ AI MEMORY & PERSONALIZATION MODELS ============

model AIMemoryProfile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Free-form profile JSON storing aggregated signals, e.g. strengths, weaknesses, preferences
  profileData    Json
  // Compact metrics for quick queries
  compositeScore Float?
  xp             Float    @default(0)
  lastUpdated    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RecommendationHistory {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  userId         String  @db.ObjectId
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stores the recommended item and metadata
  recommendation Json
  reason         String?
  score          Float?
  source         String? // e.g., 'assessment', 'ai-engine', 'manual'

  createdAt DateTime @default(now())

  @@index([userId])
}

// Cached AI outputs to avoid repeat Gemini calls for identical prompts
model RecommendationSnapshot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  requestHash   String
  promptVersion String
  provider      String
  model         String
  input         Json?
  response      Json
  expiresAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, requestHash, promptVersion, provider, model])
  @@index([userId])
  @@index([expiresAt])
}

model RoadmapMutation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Mutation record describing the change: branching, milestone added, pacing adjusted
  mutation  Json
  reason    String?
  appliedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
}

model PersonalityProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         Json // e.g., mentorType, tone, affinity
  confidence      Float?
  lastEvaluatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LearningVelocity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStart DateTime
  windowEnd   DateTime
  metrics     Json // e.g., tasksCompleted, xpEarned, avgTimePerTask

  createdAt DateTime @default(now())

  @@index([userId])
}

// Persisted snapshots of adaptive decision evaluations for longitudinal analysis
model DecisionSnapshot {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot Json // full engine output (evaluated list, meta)
  topItems String[] // cached top career titles
  meta     Json? // lightweight meta like avgVelocity, xp, traitCount

  createdAt DateTime @default(now())

  @@index([userId])
}

model GeneratedNote {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic          String
  format         String
  source         String   @default("ai-counselor")
  sourceMessageId String?
  fileName       String
  mimeType       String
  byteSize       Int
  contentHash    String
  metadata       Json
  content        String?
  generatedAt    DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([topic])
  @@index([format])
  @@index([generatedAt])
  @@unique([userId, contentHash, format])
}

model MentorConversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  journeyId String?  @db.ObjectId
  title     String
  context   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([journeyId])
}

model MentorMessage {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  role           String
  content        String
  contextSnapshot Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model CareerJourney {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slug             String   @unique
  title            String
  roadmapId        String?  @db.ObjectId
  duration         String
  industryDemand   String
  salaryRange      String
  estimatedDays    Int
  requiredSkills   String[]
  learningStructure Json?
  aiContext        Json?
  active           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roadmapId])
}

model JourneyDay {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  journeyId        String        @db.ObjectId
  dayNumber        Int
  title            String
  focus            String
  topics           String[]
  tasks            Json?
  resources        Json?
  estimatedMinutes Int
  xpReward         Int
  isMilestone      Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@index([journeyId, dayNumber])
